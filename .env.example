# kidstory-api companion service (../kidstory-api). All story reads/writes, story
# generation and both agents (story writing, Facebook/Instagram sharing) go through
# it; the key must match the API's own KIDSTORY_API_KEY. The Facebook and Instagram
# tokens are set on the API now, not here.
KIDSTORY_API_URL=http://localhost:8000
KIDSTORY_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
GMAIL_USER=
GMAIL_APP_PASSWORD=
NOTIFY_EMAILS=
SITE_URL=
# Shared secret for the Vercel Cron daily-post route (any long random string).
# Set the same value in the Vercel project's env vars.
CRON_SECRET=
# Emails (comma-separated) allowed to sign in to /studio with their Supabase
# email + password. Empty locks the studio for everyone.
STUDIO_EMAILS=

# Gemini, for the Studio voice agent's voice and listening: a Google AI Studio API key
# (free tier). Optional: GEMINI_TTS_VOICE (default Sulafat), GEMINI_TTS_MODEL, GEMINI_STT_MODEL.
GEMINI_API_KEY=

# Send stories from the Studio to your own WhatsApp, through CallMeBot (free): save their
# bot's number (callmebot.com), send it "I allow callmebot to send me messages", and put
# the key it replies with here, with your number including the country code.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
